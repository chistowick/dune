COMPOSE_PROJECT_NAME=dune

#users ids (bash `id $USER`)
PUID=1000
PGID=1000

#nginx
NGINX_HOST_HTTP_PORT=9999

#postgres
POSTGRES_PORT=5440
POSTGRES_DB=dune_db
POSTGRES_USER=dune-admin
POSTGRES_PASSWORD=dune-admin-password

RABBITMQ_USER=dune-admin
RABBITMQ_PASSWORD=dune-admin-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_WEB_UI_PORT=15672

#php
PHP_FPM_PORT=9000

#node
NODE_PORT=5178
